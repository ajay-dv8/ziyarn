    "typescript": "5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "framer-motion": "^14.14.0"
  }
}
