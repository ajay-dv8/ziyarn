{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "NEXT_PUBLIC_BETTER_AUTH_URL", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "LINKEDIN_CLIENT_ID", "LINKEDIN_CLIENT_SECRET", "OPENAI_API_KEY", "AI_MODEL", "LOG_LEVEL", "GEMINI_API_KEY", "GEMINI_BASE_URL", "OPENROUTER_API_KEY", "OPENROUTER_BASE_URL", "FALLBACK_MODEL", "EMBEDDING_MODEL", "EMBEDDING_DIMENSIONS", "BASE_APP_URL", "PORTAL_URL_SECRET", "STRIPE_SECRET_KEY", "STRIPE_PUBLISHABLE_KEY", "STRIPE_WEBHOOK_SECRET", "STRIPE_APP_FEE_BASIS_POINTS", "STRIPE_PRICE_STANDARD", "STRIPE_PRICE_PRO", "STRIPE_PRICE_ULTIMATE", "SMTP_HOST", "SMTP_PORT", "SMTP_USER", "SMTP_PASS", "SMTP_FROM", "RESEND_WEBHOOK_SECRET", "CRON_SECRET", "STORAGE_DIR", "BLOB_READ_WRITE_TOKEN", "BLOB_STORE_ID", "PAYSTACK_SECRET_KEY", "PAYSTACK_PUBLIC_KEY", "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY", "PAYSTACK_CURRENCY", "PAYSTACK_WEBHOOK_SECRET", "PAYSTACK_PRICE_STANDARD", "PAYSTACK_PRICE_PRO", "PAYSTACK_PRICE_ULTIMATE", "PAYSTACK_PLAN_STANDARD", "PAYSTACK_PLAN_PRO", "PAYSTACK_PLAN_ULTIMATE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
