# Admin panel (apps/admin) — separate from the customer app's auth.
# Copy to .env and fill in. NEVER reuse BETTER_AUTH_SECRET here: sharing it
# would let an admin session token be replayed against the customer app.

# Shared database (same Neon project as apps/web)
DATABASE_URL=

# Admin auth secret — generate a fresh random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BETTER_AUTH_SECRET=

# Public URL of the ADMIN app (not the customer app)
ADMIN_BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_BETTER_AUTH_URL=http://localhost:3001
