{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:widget": "node scripts/build-widget.mjs",
    "check-widget": "node scripts/build-widget.mjs --check",
    "predev": "node scripts/build-widget.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/build-widget.mjs",
    "build": "next build",
    "postinstall": "fumadocs-mdx generate",
    "start": "next start",
    "lint": "node scripts/build-widget.mjs --check && eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:widget": "node scripts/widget-e2e.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@repo/ai": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/money": "workspace:*",
    "@repo/routes": "workspace:*",
    "@repo/ui": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.44.7",
    "fumadocs-core": "^16.0.0",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-ui": "^16.0.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "pino": "^9.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-paystack": "^6.0.0",
    "sonner": "^2.0.8",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/widget-core": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "^5.0.5"
  }
}
