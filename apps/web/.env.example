# Ziyarn web app environment.
# Copy to apps/web/.env and fill in. Never commit the filled file.
#
# Required values are marked. Optional integrations stay disabled when blank.
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Neon (or any Postgres) connection string. Use the pooled connection string.
DATABASE_URL=

# Signs sessions. Must be at least 32 random characters. Never reuse the admin
# app's secret here.
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Absolute base URL used in emails and portal links.
BASE_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OAuth (optional)
# Social buttons only render when a provider's ID and secret are both set.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI providers
# At least one provider key is required for chat. Free-tier keys are fine for
# development; production should use a key you control.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional custom endpoint/proxy.
GEMINI_BASE_URL=
OPENROUTER_API_KEY=
# Optional custom endpoint/proxy.
OPENROUTER_BASE_URL=
# Optional. The app primarily uses Gemini and OpenRouter.
OPENAI_API_KEY=

# Optional model overrides. Leave blank to use the built-in defaults.
AI_MODEL=
FALLBACK_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ---------------------------------------------------------------------------
# Email / SMTP
# Required for campaigns, escalation notifications, and password reset once
# that flow is enabled. Any SMTP provider works.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ziyarn <no-reply@example.com>

# Only needed if you use Resend webhooks.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Paystack subscriptions (required for paid plans)
# Test-mode keys work for the whole checkout flow. Amounts are in minor units
# (pesewas/kobo), e.g. PAYSTACK_PRICE_STANDARD=5000 means GHS 50.00.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS
# Verifies the x-paystack-signature header. Required for webhooks.
PAYSTACK_WEBHOOK_SECRET=

PAYSTACK_PRICE_STANDARD=
PAYSTACK_PRICE_PRO=
PAYSTACK_PRICE_ULTIMATE=

# Optional plan-code overrides created in the Paystack dashboard.
PAYSTACK_PLAN_STANDARD=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ULTIMATE=

# ---------------------------------------------------------------------------
# Stripe Connect (optional)
# Only used by the portal's customer-payment rail if you choose Stripe. Platform
# subscriptions do not require these. Live charges carry processor fees.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APP_FEE_BASIS_POINTS=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=

# ---------------------------------------------------------------------------
# File storage
# Local disk is the default in development. Set the Blob token for durable
# uploads on Vercel, where the filesystem is ephemeral.
# ---------------------------------------------------------------------------
STORAGE_DIR=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# ---------------------------------------------------------------------------
# Scheduler / signed links
# ---------------------------------------------------------------------------
# Protects /api/campaigns/process-scheduled (and future cron endpoints).
CRON_SECRET=

# Signs portal links. Falls back to BETTER_AUTH_SECRET when blank.
PORTAL_URL_SECRET=

# ---------------------------------------------------------------------------
# Sentry (optional)
# Errors are disabled when the DSNs are blank. The auth token is server-only
# and is used to upload source maps during `next build`; it must never be
# exposed with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=info
